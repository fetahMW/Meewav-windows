{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meewav.com/schemas/audio-engine/plugin-scan-request.v1.json",
  "title": "MeeWav isolated plugin scan request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "allowlistedPluginIds", "perPluginTimeoutMs"],
  "properties": {
    "contractVersion": { "const": 1 },
    "allowlistedPluginIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 128,
        "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
      }
    },
    "perPluginTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 30000 }
  }
}
