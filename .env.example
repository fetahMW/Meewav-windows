VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# La Wave — aucun fallback silencieux en production.
# `production` exige les RPC, Edge Functions, stockage privé et workers Wave.
# `local-explicit` expose seulement un état local non opérationnel et refuse
# les commandes audio critiques au lieu de simuler un succès.
VITE_WAVE_INFRA_MODE=production

# Globe web
# Use the exact iOS Mapbox Studio style URL here once recovered.
VITE_MAPBOX_TOKEN=
VITE_MAPBOX_STYLE_URL=mapbox://styles/mapbox/dark-v11
VITE_API_BASE_URL=

# Donnees privees de demonstration (developpement local uniquement).
# Laisser false pour tester les vrais etats loading/error/empty Supabase.
VITE_PROFILE_PRIVATE_DEMO=false

# Serveur de tuiles vectorielles (MVT) pour le Globe
# Le pipeline MVT est actif par defaut. Mettre false uniquement pour diagnostiquer
# le fallback GeoJSON local.
VITE_USE_VECTOR_TILE_SERVER=true
VITE_MVT_TILE_URL=http://localhost:5000/musicians_clustered/{z}/{x}/{y}
VITE_AVATAR_API_BASE_URL=http://localhost:5000

# Laboratoire interne uniquement. Le mode normal et la production restent OFF.
VITE_OPENDAW_VOICE_CORRECTION_LAB=false
