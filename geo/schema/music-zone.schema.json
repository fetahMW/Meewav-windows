{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meewav.app/schemas/geography/music-zone.schema.json",
  "title": "Meewav MusicZone",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "zoneId",
    "displayName",
    "aliases",
    "communeCode",
    "communeName",
    "parentZoneId",
    "sourceZoneIds",
    "sourceType",
    "sourceVintage",
    "geometry",
    "bbox",
    "center",
    "labelPoint",
    "status",
    "quality"
  ],
  "properties": {
    "zoneId": {
      "type": "string",
      "format": "uuid"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "communeCode": {
      "type": "string",
      "minLength": 1
    },
    "communeName": {
      "type": "string",
      "minLength": 1
    },
    "parentZoneId": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "sourceZoneIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uuid" },
      "uniqueItems": true
    },
    "sourceType": {
      "enum": ["official", "merged", "local", "generated", "commune_fallback", "custom"]
    },
    "sourceVintage": {
      "type": "string",
      "minLength": 1
    },
    "geometry": {
      "$ref": "administrative-zone.schema.json#/$defs/geometry"
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 },
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "center": {
      "$ref": "administrative-zone.schema.json#/$defs/position"
    },
    "labelPoint": {
      "$ref": "administrative-zone.schema.json#/$defs/position"
    },
    "status": {
      "enum": ["draft", "validated", "published"]
    },
    "quality": {
      "enum": ["official", "curated", "fallback"]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colorIndex", "groundColor", "territoryType", "paletteFamily", "overviewVisible"],
      "properties": {
        "colorIndex": { "type": "integer", "minimum": 0 },
        "groundColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "territoryType": {
          "enum": ["department", "commune", "commune_deleguee", "quartier", "iris", "qpv"]
        },
        "paletteFamily": { "enum": ["city", "metropolitan"] },
        "overviewVisible": { "type": "boolean" }
      }
    },
    "cameraOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zoom": { "type": "number", "minimum": 0, "maximum": 24 },
        "pitch": { "type": "number", "minimum": 0, "maximum": 85 },
        "bearing": { "type": "number", "minimum": -360, "maximum": 360 },
        "padding": { "type": "number", "minimum": 0 }
      }
    }
  }
}
